<?xml version="1.0" encoding="utf-8"?>
<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/themeCard"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="8dp"
	android:background="@drawable/bg_theme_card_rounded"
	android:orientation="vertical"
	android:padding="12dp">

	<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
		android:id="@+id/themePrompt"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:fontFamily="monospace"
		android:textDirection="ltr"
		android:textSize="12sp" />

	<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
		android:id="@+id/themeName"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:textSize="12sp"
		android:textStyle="bold" />

</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>
