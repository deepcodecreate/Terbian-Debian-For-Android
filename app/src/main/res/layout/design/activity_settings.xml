<?xml version="1.0" encoding="utf-8"?>
<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/settingsRoot"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/bg"
	android:fitsSystemWindows="true"
	android:orientation="vertical">

	<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
		android:id="@+id/settingsHeader"
		android:layout_width="match_parent"
		android:layout_height="56dp"
		android:background="@color/surface"
		android:gravity="center_vertical"
		android:paddingStart="16dp"
		android:paddingEnd="4dp">

		<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:orientation="vertical">

			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/settingsTitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/settings"
				android:textColor="@color/fg"
				android:textSize="16sp"
				android:textStyle="bold" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/settingsSubtitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/settings_sub"
				android:textColor="@color/subtle"
				android:textSize="11sp" />

		</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

		<org.appdevforall.codeonthego.layouteditor.editor.palette.buttons.ImageButtonDesign
			android:id="@+id/closeSettings"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/close"
			android:src="@drawable/ic_close"
			android:tint="@color/fg" />

	</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

	<org.appdevforall.codeonthego.layouteditor.editor.palette.containers.ScrollViewDesign
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:padding="16dp"
		android:scrollbarStyle="outsideOverlay"
		android:overScrollMode="ifContentScrolls">

		<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/labelTerminalColor"
				style="@style/SettingsLabel"
				android:text="@string/terminal_color" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/helpTerminalColor"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:text="@string/terminal_color_help"
				android:textColor="@color/muted"
				android:textSize="13sp" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/themeGrid"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/labelFontSize"
				style="@style/SettingsLabel"
				android:layout_marginTop="24dp"
				android:text="@string/font_size" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
					android:id="@+id/fontValue"
					android:layout_width="36dp"
					android:layout_height="wrap_content"
					android:fontFamily="monospace"
					android:gravity="end"
					android:textColor="@color/muted"
					android:textSize="14sp" />

			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/labelCursor"
				style="@style/SettingsLabel"
				android:layout_marginTop="24dp"
				android:text="@string/cursor" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal">

				<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
					android:id="@+id/cursorBlock"
					style="@style/CursorChip"
					android:text="block" />

				<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
					android:id="@+id/cursorBar"
					style="@style/CursorChip"
					android:text="bar" />

				<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
					android:id="@+id/cursorUnderline"
					style="@style/CursorChip"
					android:text="underline" />

			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/rowBlink"
				style="@style/SettingsRow">

				<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
					android:id="@+id/labelBlink"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/blink_cursor"
					android:textColor="@color/fg" />

				<androidx.appcompat.widget.SwitchCompat
					android:id="@+id/switchBlink"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" />

			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/helpBlink"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="4dp"
				android:text="@string/blink_help"
				android:textColor="@color/subtle"
				android:textSize="12sp" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
				android:id="@+id/labelKeyboard"
				style="@style/SettingsLabel"
				android:layout_marginTop="24dp"
				android:text="@string/keyboard" />

			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/rowKeys"
				style="@style/SettingsRow">

				<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
					android:id="@+id/labelKeys"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/extra_keys"
					android:textColor="@color/fg" />

				<androidx.appcompat.widget.SwitchCompat
					android:id="@+id/switchKeys"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" />

			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

			<org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign
				android:id="@+id/rowBell"
				style="@style/SettingsRow">

				<org.appdevforall.codeonthego.layouteditor.editor.palette.text.TextViewDesign
					android:id="@+id/labelBell"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/visual_bell"
					android:textColor="@color/fg" />

				<androidx.appcompat.widget.SwitchCompat
					android:id="@+id/switchBell"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content" />

			</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

		</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>

	</org.appdevforall.codeonthego.layouteditor.editor.palette.containers.ScrollViewDesign>

</org.appdevforall.codeonthego.layouteditor.editor.palette.layouts.LinearLayoutDesign>