<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:background="@color/surface">

        <TextView
            android:id="@+id/activeSessionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/newSessionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/new_session"
            android:src="@drawable/ic_add"
            android:tint="@color/fg" />

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_more"
            android:tint="@color/fg" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/sessionTabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/surface"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/primary"
        app:tabIndicatorHeight="2dp"
        app:tabRippleColor="@color/primary_container"
        app:tabTextColor="@color/subtle"
        app:tabSelectedTextColor="@color/fg"
        app:tabUnboundedRipple="true" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/sessionPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ScrollView
            android:id="@+id/installOverlayScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/installOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/fg"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:textDirection="ltr"
                android:textAlignment="viewStart"
                android:lineSpacingExtra="2dp" />
        </ScrollView>
    </FrameLayout>

    <com.terbian.ui.ExtraKeysView
        android:id="@+id/extraKeys"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/surface" />

</LinearLayout>
